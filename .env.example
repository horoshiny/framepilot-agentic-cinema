GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Optional approved destination for real Vertex Veo output retrieval.
# Both values must be configured; no bucket is created by FramePilot.
# VEO_OUTPUT_GCS_BUCKET=
# VEO_OUTPUT_GCS_PREFIX=framepilot/
# Keep the published app locked to deterministic demo mode by default.
DEMO_MODE=true
ALLOW_VERTEX_INFERENCE=false
# Keep real Veo disabled; live-test allowances remain one global and one per client IP.
VIDEO_GENERATION_PROVIDER=mock
ALLOW_VEO_GENERATION=false
MAX_REAL_VEO_GENERATIONS_GLOBAL=1
MAX_REAL_VEO_GENERATIONS_PER_IP=1
MAX_REAL_DIRECTORS_CUT_GENERATIONS_GLOBAL=0
# Keep completed-video critique offline by default.
VIDEO_CRITIQUE_PROVIDER=mock
ALLOW_VIDEO_CRITIQUE=false
VIDEO_CRITIQUE_GLOBAL_LIMIT=5
